[Unit]
Description=PRD-029 events-index builder — dedupe trending journal, join images, emit events.jsonl + events.idx for the news-timeline route
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=zettair
WorkingDirectory=/opt/zettair-search
# PRD-029 step 2a: fetch any missing Wikipedia categories for new
# entities. Incremental + idempotent — hits the API only for docnos
# not yet in the cache.
ExecStartPre=/usr/bin/python3 -u /opt/zettair-search/tools/fetch_wikipedia_categories.py
# PRD-029 step 2b: classify events using the wiki-cats sidecar.
ExecStartPre=/usr/bin/python3 -u /opt/zettair-search/tools/build_event_categories.py
# PRD-029 day-roundup snapshot: capture the current state of any
# <date>:day entries in summaries.store into an append-only journal,
# so the rendered timeline does not drift when the LLM regenerates.
ExecStartPre=/usr/bin/python3 -u /opt/zettair-search/tools/snapshot_day_summaries.py
# Main: build the events.jsonl + events.idx (categories + day-roundup
# summaries joined into the idx).
ExecStart=/usr/bin/python3 -u /opt/zettair-search/tools/build_events_index.py
# Refresh entity-colour assignments based on the latest journal.
ExecStartPost=/usr/bin/python3 -u /opt/zettair-search/tools/build_entity_colors.py
# Enqueue any missing day-roundup summary jobs (depends on Mac Mini
# supporting the day-roundup prompt mode; harmless to enqueue early).
ExecStartPost=/usr/bin/python3 -u /opt/zettair-search/tools/build_day_summary_jobs.py
StandardOutput=journal
StandardError=journal

# A full build reads the journal (small, KB-MB), the entity-class
# JSON (~30 MB loaded), and pulls image-store entries via FlatStore
# (mmap'd). Peak heap is dominated by the entity-class dict.
MemoryMax=512M
