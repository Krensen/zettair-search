[Unit]
Description=PRD-020 trending — fetch hourly pageview dump, score, write current.json
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=zettair
WorkingDirectory=/opt/zettair-search
ExecStart=/usr/bin/python3 /opt/zettair-search/tools/fetch_trending.py
ExecStartPost=/usr/bin/python3 /opt/zettair-search/tools/build_news_summary_jobs.py
StandardOutput=journal
StandardError=journal

# Memory cap so a pathological day cannot OOM the box. Empirical
# floor: the gzipped pageviews dump streams in at ~60 MB; the in-
# memory counts dict has crept up to ~1.9M Python str keys
# (~350-500 MB) as Wikipedia traffic grows. Plus PRD-022/026: the
# specificity gate fetches Wikipedia wikitext for up to
# MAX_CANDIDATES_TO_GATE candidates and Google News + ITN headlines
# for each, then caches them in-process.
#
# History: 512M (PRD-020) -> OOM-killed -> 1G (May 21 fix) -> OOM
# again at ~1.9M titles (Jun 4) -> 2G now. Box has 7.6 GiB; the
# search service uses ~2 GiB resident, leaving plenty of headroom.
# A real fix is to drop the counts-dict altogether (stream straight
# to the top-1000 with a heap) — tracked as a follow-up.
MemoryMax=2G

# PRD-021: ExecStartPost chains the news-summary producer right after
# the trending fetch writes current.json. Both run as zettair so no
# privilege escalation needed. Avoids the up-to-3h gap where a newly-
# spiking query would wait for the news producer's own timer. The
# producer's standalone timer is kept as a boot-time / catch-up
# backstop.
