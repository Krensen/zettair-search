[Unit]
Description=PRD-020 trending — fetch hourly pageview dump, score, write current.json
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=zettair
WorkingDirectory=/opt/zettair-search
ExecStart=/usr/bin/python3 /opt/zettair-search/tools/fetch_trending.py
ExecStartPost=/usr/bin/python3 /opt/zettair-search/tools/build_news_summary_jobs.py
StandardOutput=journal
StandardError=journal

# Memory cap so a pathological day cannot OOM the box. Empirical
# floor: the gzipped pageviews dump streams in at ~60 MB and the
# in-memory counts dict reaches ~1.7M Python str keys (~250-400 MB).
# Plus PRD-022/026: the specificity gate fetches Wikipedia wikitext
# for up to MAX_CANDIDATES_TO_GATE candidates and Google News + ITN
# headlines for each, then caches them. The previous 512M was tight
# and the unit was being OOM-killed mid-run; 1G gives ~2x headroom.
MemoryMax=1G

# PRD-021: ExecStartPost chains the news-summary producer right after
# the trending fetch writes current.json. Both run as zettair so no
# privilege escalation needed. Avoids the up-to-3h gap where a newly-
# spiking query would wait for the news producer's own timer. The
# producer's standalone timer is kept as a boot-time / catch-up
# backstop.
